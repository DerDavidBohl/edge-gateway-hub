# Runtime environment – contains secrets
.env

# WireGuard server keys and assembled configs (generated by setup-gateway.sh)
data/wireguard/server_private.key
data/wireguard/server_public.key
data/wireguard/wg_interface.conf
data/wireguard/wg_confs/
data/wireguard/peers/

# Peer key files and client WireGuard configs (sensitive)
data/keys/

# Runtime state files (generated during operation)
data/ipam.json
data/sites.json

# Generated Nginx stream configs
data/nginx/*.conf
