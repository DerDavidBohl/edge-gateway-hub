# edge-gateway-hub — Configuration Template
# Copy to .env and adjust, OR run:  bash scripts/setup-gateway.sh

# ── Gateway ───────────────────────────────────────────────────────────────────
# Public IP address of this edge gateway host
GATEWAY_PUBLIC_IP=1.2.3.4

# WireGuard UDP listen port
WG_PORT=51820

# ── Subnets ───────────────────────────────────────────────────────────────────
# Access Client Network (road warriors, admins)
CLIENT_SUBNET=10.101.0.0/24

# Internal Node Network (home servers, NAS – only reachable by Access Clients)
INTERNAL_SUBNET=10.102.0.0/24

# Edge Service Network (peers hosting public TCP/UDP services via Nginx proxy)
EDGE_SUBNET=10.103.0.0/24
